# Ultimate Trading Bot — environment variables.
# Copy to .env (never commit it) or export in your shell / container.
# All secrets live HERE, never in config.json.

# --- Live-trading two-key safety gate -------------------------------------
# Live mode requires BOTH mode:"live" (config or TRADING_MODE=live) AND this
# exact value. Leave unset for paper trading (the default).
#TRADING_BOT_LIVE=YES

# --- Mode / exchange overrides ---------------------------------------------
#TRADING_MODE=paper            # paper | live (overrides config.json "mode")
#EXCHANGE_ID=kraken            # any ccxt id, or "robinhood" (live only)

# --- ccxt exchange credentials (live mode, non-Robinhood) -------------------
#EXCHANGE_API_KEY=
#EXCHANGE_API_SECRET=
#EXCHANGE_PASSWORD=            # only exchanges that need a passphrase

# --- Robinhood Crypto (live mode, EXCHANGE_ID=robinhood) --------------------
# Generate the keypair with: python main.py keygen
#ROBINHOOD_API_KEY=
#ROBINHOOD_PRIVATE_KEY=

# --- Notifications (auto-enable when set) -----------------------------------
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
#DISCORD_WEBHOOK_URL=

# --- Dashboard ---------------------------------------------------------------
# The dashboard has NO authentication. Keep it on 127.0.0.1 unless you have
# put a reverse proxy with auth in front of it. In Docker, 0.0.0.0 is needed
# for -p port mapping — do that consciously.
#DASHBOARD_HOST=127.0.0.1
#DASHBOARD_PORT=8899
